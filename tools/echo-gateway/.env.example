PUBLIC_STREAM_TOKEN=replace-with-secrets-token-urlsafe-32
PUBLIC_BASE_URL=https://YOUR_MACHINE.YOUR_TAILNET.ts.net
ALLOW_OPEN_TEST_STREAM=false
ALEXA_SKILL_ID=
SKIP_ALEXA_SIGNATURE_VERIFY=false
MAX_CONCURRENT_STREAMS=4
TARGET_LUFS=-11
# Host folder for sessions, loudness results and art cache.
ECHO_STATE_DIR=./state
# Path inside the container. Compose sets this; only change it outside Docker.
STATE_DIR=/state
