[Unit]
Description=Kainos Echo gateway (Docker Compose)
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__GATEWAY_DIR__
# docker.service is not enabled at boot. This connects to docker.socket, which starts it.
ExecStart=/usr/bin/docker compose up -d
Restart=on-failure
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=default.target
