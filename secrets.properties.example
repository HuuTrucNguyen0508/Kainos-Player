# Copy to secrets.properties (never commit the real file) or export the same keys.
# Universal Music Player never ships API secrets.

# Official Spotify Web API — create an app at https://developer.spotify.com/dashboard
# Redirect URI for Linux: http://127.0.0.1:43821/callback
# Redirect URI for Android: universalmusic://spotify-callback
SPOTIFY_CLIENT_ID=

# Official YouTube Data API v3 key — search and metadata only.
# There is no supported YouTube Music playback API for third-party players.
YOUTUBE_DATA_API_KEY=

# Official SoundCloud API — requires an approved application.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
