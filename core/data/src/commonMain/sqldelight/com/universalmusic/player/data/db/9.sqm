-- Schema 9 -> 10. Later lanes on feat/next-data append their own sections below.

-- ── Local file tags (lane L2a) ──────────────────────────────────────────────
-- Tags read from the file itself, beside the scan row's track_json. tags_version is 0 for
-- rows whose title/artist/album are still filename and folder guesses; a reader bumps it
-- once it has opened the file, so unchanged files are not reopened on the next scan.
ALTER TABLE local_track ADD COLUMN album_artist TEXT;
ALTER TABLE local_track ADD COLUMN track_number INTEGER;
ALTER TABLE local_track ADD COLUMN disc_number INTEGER;
ALTER TABLE local_track ADD COLUMN release_year INTEGER;
ALTER TABLE local_track ADD COLUMN genre TEXT;
ALTER TABLE local_track ADD COLUMN tags_version INTEGER NOT NULL DEFAULT 0;

-- ── Loudness (lane L2b) ─────────────────────────────────────────────────────
-- EBU R128 loudness of files without ReplayGain tags, measured by ffmpeg on the desktop or
-- received from it over Home sync, so volume levelling works on untagged files.
CREATE TABLE track_loudness (
    location TEXT NOT NULL PRIMARY KEY,
    content_length INTEGER,
    file_modified_ms INTEGER,
    integrated_lufs REAL,
    true_peak_dbtp REAL,
    duration_ms INTEGER,
    album_key TEXT,
    album_lufs REAL,
    album_peak_dbtp REAL,
    origin TEXT NOT NULL
);
