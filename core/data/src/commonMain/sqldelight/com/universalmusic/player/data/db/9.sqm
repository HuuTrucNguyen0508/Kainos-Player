-- Schema 9 -> 10. Later lanes on feat/next-data append their own sections below.

-- ── Local file tags (lane L2a) ──────────────────────────────────────────────
-- Tags read from the file itself, beside the scan row's track_json. tags_version is 0 for
-- rows whose title/artist/album are still filename and folder guesses; a reader bumps it
-- once it has opened the file, so unchanged files are not reopened on the next scan.
ALTER TABLE local_track ADD COLUMN album_artist TEXT;
ALTER TABLE local_track ADD COLUMN track_number INTEGER;
ALTER TABLE local_track ADD COLUMN disc_number INTEGER;
ALTER TABLE local_track ADD COLUMN release_year INTEGER;
ALTER TABLE local_track ADD COLUMN genre TEXT;
ALTER TABLE local_track ADD COLUMN tags_version INTEGER NOT NULL DEFAULT 0;

-- ── Loudness (lane L2b) ─────────────────────────────────────────────────────
-- EBU R128 loudness of files without ReplayGain tags, measured by ffmpeg on the desktop or
-- received from it over Home sync, so volume levelling works on untagged files.
CREATE TABLE track_loudness (
    location TEXT NOT NULL PRIMARY KEY,
    content_length INTEGER,
    file_modified_ms INTEGER,
    integrated_lufs REAL,
    true_peak_dbtp REAL,
    duration_ms INTEGER,
    album_key TEXT,
    album_lufs REAL,
    album_peak_dbtp REAL,
    origin TEXT NOT NULL
);

-- ── Spotify library and sync skips (lane L2c) ───────────────────────────────
-- The Spotify account's Liked Songs and playlists, saved so the Library shows them without the
-- network and refreshes fetch only what changed; and Home sync copies the user skipped, so a
-- skipped file is not offered again until it changes.
CREATE TABLE spotify_library_state (
    account_id TEXT NOT NULL PRIMARY KEY,
    liked_total INTEGER,
    liked_unmapped INTEGER NOT NULL DEFAULT 0,
    liked_checked_at_ms INTEGER,
    playlists_checked_at_ms INTEGER
);

CREATE TABLE spotify_liked_track (
    account_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    spotify_track_id TEXT NOT NULL,
    added_at TEXT,
    track_json TEXT NOT NULL,
    PRIMARY KEY (account_id, position)
);

CREATE TABLE spotify_playlist (
    account_id TEXT NOT NULL,
    playlist_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    snapshot_id TEXT,
    title TEXT NOT NULL,
    description TEXT,
    artwork_url TEXT,
    owner_name TEXT,
    track_count INTEGER,
    tracks_snapshot_id TEXT,
    tracks_saved_at_ms INTEGER,
    PRIMARY KEY (account_id, playlist_id)
);

CREATE TABLE spotify_playlist_track (
    account_id TEXT NOT NULL,
    playlist_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    track_json TEXT NOT NULL,
    PRIMARY KEY (account_id, playlist_id, position)
);

CREATE TABLE home_sync_skip (
    peer_device_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    subject TEXT NOT NULL,
    direction TEXT NOT NULL,
    file_identity TEXT NOT NULL,
    label TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    skipped_at_ms INTEGER NOT NULL,
    PRIMARY KEY (peer_device_id, kind, subject, direction)
);
